# ─────────────────────────── Roster configuration ───────────────────────────
# Copy to `.env` and fill in. NEVER commit the real `.env` (see .gitignore).

# ---- Core ----
NODE_ENV=development
PORT=3010

# ---- Database (Postgres) ----
# docker-compose ships a local one on 5432.
DATABASE_URL=postgresql://roster:roster@localhost:5432/roster?schema=public

# ---- Redis (BullMQ queue + scheduler) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Secret used to sign the bundled dev JWT. Generate one with:
#   openssl rand -hex 32
# In production, put Roster behind your own identity provider instead.
JWT_SECRET=change-me-please-generate-a-real-secret

# ---- Telegram bot (optional; the app runs without it, just no notifications) ----
# Create a bot via @BotFather, then:
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secret token Telegram echoes back in X-Telegram-Bot-Api-Secret-Token.
# Generate with: openssl rand -hex 24
# REQUIRED in production when TELEGRAM_ENABLED=true (webhook is rejected without it).
TELEGRAM_WEBHOOK_SECRET=

# ---- Scheduling ----
# Cron expression + IANA timezone for the daily roll-up review push.
DAILY_REVIEW_CRON=0 18 * * *
DAILY_REVIEW_TIMEZONE=UTC
# Recurrence clock times and the daily review's "today" use the server's local
# timezone. Set it when the server runs in a different zone than the team:
# TZ=Asia/Taipei
